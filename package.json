{
  "name": "stickman-arena",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Stickman Arena: an original, browser-based, fully 3D real-time arena fighting game.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@dimforge/rapier2d": "^0.21.0",
    "pixi.js": "^8.22.0"
  }
}
